#include <stdio.h>

int main() {
    int n;

    // Read size
    scanf("%d", &n);

    int A[n];

    // Read elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &A[i]);
    }

    // Insertion Sort
    for (int i = 1; i < n; i++) {
        int key = A[i];
        int j = i - 1;

        while (j >= 0 && A[j] > key) {
            A[j + 1] = A[j];
            j--;
        }

        A[j + 1] = key;
    }

    // Print sorted array
    for (int i = 0; i < n; i++) {
        printf("%d ", A[i]);
    }

    return 0;
}
